# Copy to .env (never commit it, never put it in a ZIP you share).
# Generate the two secrets with:  npm run secrets   (each must be 32+ random characters; the server refuses placeholders)
PORT=3000
BASE_URL=http://localhost:3000   # use https:// in production: cookies become Secure automatically
DB_PATH=./medicare.db
JWT_SECRET=
QR_SECRET=
# Local demo seed only (never use in production):
SEED_PASSWORD=Demo@12345
