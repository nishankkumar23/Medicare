{
  "name": "medicare-ehr",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-force-exit --no-warnings test/safety.test.js test/security.test.js test/api.test.js test/queue.test.js test/migration.test.js test/combobox.test.js test/ui.test.js",
    "secrets": "node scripts/secrets.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
